.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
}

.empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f7eef4;
  color: #d6407b;
  font-size: 44rpx;
}

.empty__text {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a8492;
  text-align: center;
}

.empty__retry {
  margin-top: 32rpx;
  padding: 0 40rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #f0dbe6;
  color: #d6407b;
  font-size: 26rpx;
}

.empty__retry::after {
  border: none;
}

.empty__retry--hover {
  background: #fdf4f8;
}
