.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0;
  padding: 72rpx 32rpx;
  border: 2rpx dashed rgba(18, 18, 23, 0.25);
  background: #fffdf8;
  text-align: center;
}

.empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid #121217;
  background: #ffc233;
  color: #121217;
  font-size: 40rpx;
  font-weight: 700;
}

.empty__text {
  margin-top: 24rpx;
  color: #6c6c89;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty__retry {
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 36rpx;
  border: 2rpx solid #121217;
  background: #121217;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.empty__retry::after {
  border: none;
}

.empty__retry--hover {
  opacity: 0.85;
}
