.nav {
  box-sizing: border-box;
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 80;
  border-bottom: 2rpx solid #121217;
}

.nav--bare {
  border-bottom: none;
}

.nav__bar {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding-right: 180rpx;
  padding-left: 16rpx;
}

.nav__side {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.nav__side--hover {
  background: #ffc233;
}

.nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.nav__back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav__title {
  flex: 1;
  overflow: hidden;
  color: #121217;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav__spacer {
  width: 100%;
}
