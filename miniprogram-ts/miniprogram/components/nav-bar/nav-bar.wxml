<view
  class="nav {{bare ? 'nav--bare' : ''}}"
  style="padding-top: {{statusBarHeight}}px; background: {{bg}};"
>
  <view wx:if="{{!bare}}" class="nav__bar" style="height: {{navHeight}}px;">
    <view class="nav__side" bind:tap="onBackTap" hover-class="nav__side--hover">
      <view wx:if="{{showBack}}" class="nav__back">
        <image class="nav__back-icon" src="/assets/icons/back.svg" />
      </view>
    </view>
    <view class="nav__title">{{title}}</view>
    <view class="nav__side"></view>
  </view>
</view>
<view class="nav__spacer" style="height: {{bare ? statusBarHeight : totalHeight}}px;"></view>
