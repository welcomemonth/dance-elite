.tabbar {
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  height: calc(160rpx + env(safe-area-inset-bottom));
  padding: 0 24rpx env(safe-area-inset-bottom);
  border-top: 2rpx solid #121217;
  background: #fffdf8;
}

.tabbar__item {
  box-sizing: border-box;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 160rpx;
  color: #6c6c89;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.tabbar__item--active {
  color: #5423e7;
}

.tabbar__icon {
  width: 40rpx;
  height: 40rpx;
}

.tabbar__item--center {
  position: relative;
  justify-content: flex-end;
  padding-bottom: 16rpx;
}

.tabbar__trophy {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid #121217;
  background: #ffc233;
}

.tabbar__trophy--active {
  background: #5423e7;
}

.tabbar__trophy-icon {
  width: 52rpx;
  height: 52rpx;
}

.tabbar__label--center {
  color: inherit;
}
