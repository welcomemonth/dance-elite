.events-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 40rpx 40rpx 44rpx;
  border-bottom: 2rpx solid #121217;
  background: #ffc233;
}

.hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__badge {
  padding: 12rpx 20rpx;
  border: 2rpx solid #121217;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.hero__refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid #121217;
  background: #ffffff;
}

.hero__refresh--hover {
  background: #121217;
}

.hero__refresh-icon {
  width: 36rpx;
  height: 36rpx;
}

.hero__title {
  margin-top: 48rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.12;
}

.hero__title--second {
  margin-top: 0;
}

.hero__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(18, 18, 23, 0.3);
  font-size: 22rpx;
}

.hero__meta-strong {
  font-weight: 700;
}

.filters {
  display: flex;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #121217;
  background: #ffffff;
}

.filter {
  flex: 1;
  min-width: 0;
  padding: 20rpx 4rpx;
  border: 2rpx solid transparent;
  color: #6c6c89;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.filter--active {
  border-color: #121217;
  background: #121217;
  color: #ffffff;
}

.event-list {
  padding: 32rpx;
}

.event-card {
  margin-bottom: 28rpx;
  border: 2rpx solid #121217;
  background: #ffffff;
}

.event-card--hover {
  opacity: 0.92;
}

.event-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-bottom: 2rpx solid #121217;
}

.event-card__top--featured {
  background: #5423e7;
  color: #ffffff;
}

.event-card__level--featured {
  background: #ffc233;
  color: #121217;
}

.event-card__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.event-card__dot {
  width: 12rpx;
  height: 12rpx;
  background: #ffc233;
}

.event-card__body {
  padding: 32rpx;
}

.event-card__title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.event-card__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #6c6c89;
  font-size: 24rpx;
}

.event-card__meta-icon {
  width: 28rpx;
  height: 28rpx;
}

.event-card__bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(18, 18, 23, 0.15);
}

.event-card__fee-label {
  color: #6c6c89;
  font-size: 22rpx;
}

.event-card__fee {
  margin-top: 4rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.event-card__fee-unit {
  font-size: 22rpx;
  font-weight: 400;
}

.event-card__action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.event-card__arrow {
  width: 28rpx;
  height: 28rpx;
}

.event-card__hot {
  margin-top: 24rpx;
  padding: 14rpx 18rpx;
  background: #fff4d6;
  font-size: 22rpx;
  font-weight: 700;
}

.event-card__countdown {
  margin-top: 12rpx;
  color: #5423e7;
  font-size: 22rpx;
  font-weight: 700;
}
