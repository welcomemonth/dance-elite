<view class="app-page waitlist-page">
  <nav-bar title="提交候补" bg="#fffdf8" />

  <view wx:if="{{invalid}}" class="waitlist-error">
    <view class="app-error">候补参数不完整，请返回赛事详情重试</view>
    <button class="app-btn app-btn--primary" bind:tap="onBackTap">返回</button>
  </view>

  <block wx:else>
    <view class="waitlist-band">
      <view class="waitlist-band__title">该组别名额已满</view>
      <view class="waitlist-band__text">
        {{groupText}} 当前已无空余名额。提交候补后，如有选手退赛，工作人员将按提交顺序电话联系您；候补不收费，确认名额后需重新完成报名支付。
      </view>
    </view>

    <view class="waitlist-body">
      <view class="app-field">
        <view class="app-field__label">选手姓名<text class="app-field__required">*</text></view>
        <input
          class="app-field__input"
          value="{{name}}"
          maxlength="30"
          placeholder="请输入真实姓名"
          disabled="{{idReadonly}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="app-field">
        <view class="app-field__label">身份证号</view>
        <input
          wx:if="{{!idReadonly}}"
          class="app-field__input"
          value="{{idCard}}"
          maxlength="18"
          placeholder="选填，用于年龄校验"
          bindinput="onIdCardInput"
        />
        <view wx:else class="app-field__input app-field__input--readonly">
          {{maskedIdCard}}
        </view>
      </view>

      <view class="app-field">
        <view class="app-field__label">机构名称</view>
        <input
          class="app-field__input"
          value="{{institution}}"
          maxlength="50"
          placeholder="选填"
          bindinput="onInstitutionInput"
        />
      </view>

      <view class="app-field">
        <view class="app-field__label">组别与舞种</view>
        <view class="app-field__input app-field__input--readonly">{{groupText}}</view>
      </view>

      <view class="app-field">
        <view class="app-field__label">联系电话<text class="app-field__required">*</text></view>
        <input
          class="app-field__input"
          value="{{phone}}"
          maxlength="11"
          type="number"
          placeholder="请输入 11 位手机号"
          bindinput="onPhoneInput"
        />
        <view class="app-field__hint">用于名额释放后的电话通知，请确保可接通。</view>
      </view>
    </view>

    <view class="app-fixed-bottom">
      <button class="app-btn app-btn--primary" disabled="{{submitting}}" bind:tap="onSubmit">
        {{submitting ? '提交中…' : '提交候补'}}
      </button>
    </view>
  </block>
</view>
