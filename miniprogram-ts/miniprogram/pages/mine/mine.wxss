.mine-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.mine-kicker {
  color: #121217;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.mine-hero {
  padding: 40rpx 48rpx 48rpx;
  border-bottom: 2rpx solid #121217;
  background: #ffc233;
}

.mine-hero__row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 48rpx;
}

.mine-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid #121217;
  border-radius: 50%;
  background: #eadfff;
}

.mine-info {
  flex: 1;
  min-width: 0;
}

.mine-name {
  overflow: hidden;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-phone {
  display: inline-block;
  width: auto !important;
  margin: 8rpx 0 0 !important;
  padding: 0 !important;
  border: none;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.mine-info button.mine-phone {
  width: auto !important;
  margin: 8rpx 0 0 !important;
  padding: 0 !important;
}

.mine-phone::after {
  border: none;
}

.reminder {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 40rpx;
  border-bottom: 2rpx solid #121217;
  background: #5423e7;
  color: #ffffff;
}

.reminder--hover {
  opacity: 0.92;
}

.reminder__icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid #ffffff;
  background: #ffc233;
}

.reminder__icon-image {
  width: 44rpx;
  height: 44rpx;
}

.reminder__body {
  flex: 1;
  min-width: 0;
}

.reminder__title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.reminder__hint {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 24rpx;
  opacity: 0.75;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder__action {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
}

.mine-body {
  padding: 40rpx;
}

.mine-body__kicker {
  margin-top: 64rpx;
}

.menu {
  margin-top: 24rpx;
  border-top: 2rpx solid #121217;
  border-bottom: 2rpx solid #121217;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  padding: 32rpx 0;
  border-bottom: 2rpx solid rgba(18, 18, 23, 0.15);
  text-align: left;
}

.menu > .menu-row:last-child {
  border-bottom: none;
}

.menu-row__icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.menu-row__label {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.menu-row__badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  height: 40rpx;
  padding: 0 8rpx;
  background: #ffc233;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.menu-row__arrow {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
}

/* open-type="contact" 必须用 button，外层按钮只做透明容器。
   微信 style:v2 的 button:not([size='mini']) 自带 width:184px + margin:auto，
   优先级高于普通类选择器，因此这里用更高优先级 + !important 覆盖。 */
.menu button.menu-button {
  display: block;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: left;
  overflow: visible;
}

.menu button.menu-button::after {
  border: none !important;
}

.brand-card {
  margin-top: 64rpx;
  padding: 40rpx;
  border: 2rpx solid #121217;
  background: #fffdf8;
}

.brand-card__title {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.brand-card__desc {
  margin-top: 24rpx;
  color: #6c6c89;
  font-size: 28rpx;
  line-height: 1.7;
}

.brand-card__version {
  margin-top: 40rpx;
  color: #6c6c89;
  font-size: 24rpx;
}
