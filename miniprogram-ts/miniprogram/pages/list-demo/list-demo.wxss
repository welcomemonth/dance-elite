.page {
  padding-top: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.list-header {
  padding: 0 8rpx 24rpx;
}

.list-header__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2430;
}

.list-header__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8492;
}

.list-error {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fdeef2;
  color: #b32e65;
  font-size: 24rpx;
}

.event {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(76, 40, 60, 0.05);
}

.event__main {
  flex: 1;
  min-width: 0;
}

.event__name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8492;
}

.event__fee {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #d6407b;
}

.list-footer {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b3adb9;
}
