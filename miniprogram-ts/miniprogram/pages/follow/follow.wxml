        <view
          wx:for="{{cells}}"
          wx:key="index"
          class="follow-qr__cell {{item.dark ? 'follow-qr__cell--dark' : ''}}"
        ></view>
      </view>
      <view class="follow-qr__tip">公众号二维码配置后展示</view>
