.register-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.register-error {
  padding: 96rpx 32rpx;
}

.register-hero {
  padding: 32rpx 40rpx 36rpx;
  border-bottom: 2rpx solid #121217;
  background: #5423e7;
  color: #ffffff;
}

.register-hero__label {
  font-size: 22rpx;
  opacity: 0.7;
}

.register-hero__title {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.register-hero__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.register-body {
  padding: 40rpx;
}

.register-section {
  margin-bottom: 48rpx;
}

.register-section__title {
  margin-bottom: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.app-field + .app-field {
  margin-top: 28rpx;
}

.register-note {
  padding: 24rpx;
  border: 2rpx dashed rgba(18, 18, 23, 0.25);
  color: #6c6c89;
  font-size: 22rpx;
  line-height: 1.6;
}

.dance-options {
  display: flex;
  gap: 20rpx;
}

.dance-option {
  flex: 1;
  padding: 24rpx;
  border: 2rpx solid rgba(18, 18, 23, 0.25);
  background: #ffffff;
}

.dance-option--active {
  border-color: #121217;
  background: #ffc233;
}

.dance-option__radio {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid #121217;
  border-radius: 50%;
}

.dance-option__radio-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #121217;
}

.dance-option__label {
  font-size: 28rpx;
  font-weight: 700;
}

.dance-option__hint {
  margin-top: 8rpx;
  color: #6c6c89;
  font-size: 22rpx;
}

.register-section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.register-section__head .register-section__title {
  margin-bottom: 0;
}

.register-history {
  color: #5423e7;
  font-size: 24rpx;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.register-group {
  padding: 24rpx;
  border: 2rpx solid rgba(18, 18, 23, 0.25);
  background: rgba(18, 18, 23, 0.04);
}

.register-group--matched {
  border-color: #121217;
  background: #d9f99d;
}

.register-group__hint {
  color: #6c6c89;
  font-size: 22rpx;
}

.register-group__value {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.dance-option--disabled {
  opacity: 0.45;
  background: rgba(18, 18, 23, 0.04);
}

.dance-option--disabled.dance-option--active {
  background: rgba(18, 18, 23, 0.04);
}

.register-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(18, 18, 23, 0.45);
}

.register-modal {
  width: 100%;
  padding: 40rpx;
  border: 2rpx solid #121217;
  background: #fffdf8;
}

.register-modal__title {
  font-size: 36rpx;
  font-weight: 700;
}

.register-modal__text {
  margin-top: 20rpx;
  color: #6c6c89;
  font-size: 26rpx;
  line-height: 1.7;
}

.register-modal__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
