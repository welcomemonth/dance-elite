.materials-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.materials-page--readonly {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.materials-note {
  padding: 24rpx 40rpx;
  border-bottom: 2rpx solid #121217;
  background: #fff4d6;
  font-size: 22rpx;
  line-height: 1.7;
}

.materials-load-error {
  padding: 40rpx;
}

.materials-section {
  padding: 40rpx;
  border-bottom: 2rpx solid #121217;
}

.materials-section:last-of-type {
  border-bottom: none;
}

.materials-section__title {
  font-size: 36rpx;
  font-weight: 700;
}

.upload-box {
  margin-top: 28rpx;
  padding: 32rpx;
  border: 2rpx solid #121217;
  background: #fffdf8;
}

.upload-box__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.upload-box__title {
  font-size: 28rpx;
  font-weight: 700;
}

.upload-box__hint {
  margin-top: 6rpx;
  color: #6c6c89;
  font-size: 22rpx;
}

.upload-box__photo {
  width: 200rpx;
  height: 200rpx;
  margin-top: 26rpx;
  border: 2rpx solid #121217;
  background: #eadfff;
}

.upload-box__audio {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 20rpx 24rpx;
  background: rgba(18, 18, 23, 0.04);
}

button.upload-box__play {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border: 2rpx solid #121217;
  background: #ffc233;
}

.upload-box__play-icon {
  width: 38rpx;
  height: 38rpx;
}

.upload-box__filename {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-box__play-state {
  flex-shrink: 0;
  color: #6c6c89;
  font-size: 22rpx;
}

.upload-box__placeholder {
  margin-top: 26rpx;
  padding: 48rpx 24rpx;
  border: 2rpx dashed rgba(18, 18, 23, 0.3);
  color: #6c6c89;
  font-size: 24rpx;
  text-align: center;
}

button.upload-box__action {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0;
  border: 2rpx solid #121217;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
}

.upload-box__action::after {
  border: none;
}

.materials-field {
  margin-top: 32rpx;
}

.materials-textarea {
  width: 100%;
  min-height: 192rpx;
  padding: 24rpx;
  border: 2rpx solid #121217;
  background: #ffffff;
  color: #121217;
  font-size: 28rpx;
  line-height: 1.6;
}

.materials-textarea[disabled],
.app-field__input[disabled] {
  background: rgba(18, 18, 23, 0.04);
  color: #6c6c89;
}
