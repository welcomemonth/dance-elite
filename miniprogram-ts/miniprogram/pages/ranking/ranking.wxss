.ranking-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  background: #f4f1e8;
}

.ranking-hero {
  padding: 40rpx 40rpx 44rpx;
  border-bottom: 2rpx solid #121217;
  background: #5423e7;
  color: #ffffff;
}

.ranking-hero__badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border: 2rpx solid #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.ranking-hero__title {
  margin-top: 28rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ranking-hero__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.ranking-filters {
  padding: 24rpx 32rpx 8rpx;
}

.ranking-levels {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.level-chip {
  padding: 12rpx 28rpx;
  border: 2rpx solid #121217;
  background: #fffdf8;
  font-size: 26rpx;
  font-weight: 700;
}

.level-chip--active {
  background: #ffc233;
}

.level-chip--inst {
  margin-left: auto;
  background: #ffffff;
}

.ranking-dances {
  display: flex;
  gap: 40rpx;
  margin-top: 24rpx;
  border-bottom: 2rpx solid rgba(18, 18, 23, 0.15);
}

.dance-tab {
  padding: 12rpx 0;
  color: #6c6c89;
  font-size: 28rpx;
  font-weight: 700;
}

.dance-tab--active {
  border-bottom: 4rpx solid #5423e7;
  color: #121217;
}

.ranking-search {
  height: 80rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 2rpx solid #121217;
  background: #ffffff;
  font-size: 26rpx;
}

.ranking-error {
  padding: 64rpx 32rpx;
}

.ranking-section {
  margin: 24rpx 32rpx 0;
}

.ranking-section__title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.direct-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #121217;
  background: #fff4d6;
}

.direct-row + .direct-row {
  margin-top: 12rpx;
}

.direct-row__avatar {
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid #121217;
  border-radius: 50%;
}

.direct-row__body {
  flex: 1;
  min-width: 0;
}

.direct-row__name {
  font-size: 28rpx;
  font-weight: 700;
}

.direct-row__awards {
  margin-top: 6rpx;
  color: #6c6c89;
  font-size: 22rpx;
  line-height: 1.5;
}

.direct-row__tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background: #5423e7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.rank-list {
  border: 2rpx solid #121217;
  background: #fffdf8;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 20rpx;
  border-bottom: 2rpx solid rgba(18, 18, 23, 0.1);
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-row--head {
  background: #121217;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.rank-row__rank {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.rank-row__rank--top {
  color: #5423e7;
}

.rank-row__name {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
}

.rank-row__avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
}

.rank-row__badge {
  padding: 2rpx 10rpx;
  background: #5423e7;
  color: #ffffff;
  font-size: 18rpx;
}

.rank-row__sub {
  margin-top: 4rpx;
  color: #6c6c89;
  font-size: 20rpx;
  font-weight: 400;
}

.rank-row__change {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  text-align: center;
}

.rank-row__change--up {
  color: #15803d;
}

.rank-row__change--down {
  color: #b00020;
}

.rank-row__change--same {
  color: #6c6c89;
}

.rank-row__points {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  text-align: right;
}

.advance-line {
  padding: 12rpx 20rpx;
  border-bottom: 2rpx solid #5423e7;
  background: rgba(84, 35, 231, 0.08);
  color: #5423e7;
  font-size: 20rpx;
  font-weight: 700;
}

.ranking-updated {
  margin: 24rpx 32rpx 0;
  color: #6c6c89;
  font-size: 22rpx;
  text-align: center;
}

.ranking-rules {
  margin: 20rpx 32rpx 0;
  padding: 24rpx;
  border: 2rpx dashed rgba(18, 18, 23, 0.25);
  color: #5423e7;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}
