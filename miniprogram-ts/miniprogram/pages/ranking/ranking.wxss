.ranking-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  background: #f4f1e8;
}

.ranking-hero {
  padding: 56rpx 40rpx 48rpx;
  border-bottom: 2rpx solid #121217;
  background: #5423e7;
  color: #ffffff;
}

.ranking-hero__badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border: 2rpx solid #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.ranking-hero__title {
  margin-top: 40rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ranking-hero__title--second {
  margin-top: 0;
}

.ranking-hero__desc {
  margin-top: 28rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.ranking-body {
  padding: 40rpx 32rpx;
}

.ranking-placeholder {
  padding: 72rpx 40rpx;
  border: 2rpx dashed rgba(18, 18, 23, 0.35);
  background: #fffdf8;
  text-align: center;
}

.ranking-placeholder__icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.5;
}

.ranking-placeholder__title {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.ranking-placeholder__text {
  margin-top: 16rpx;
  color: #6c6c89;
  font-size: 24rpx;
  line-height: 1.7;
}

.ranking-placeholder__link {
  display: inline-block;
  margin-top: 32rpx;
  padding-bottom: 4rpx;
  border-bottom: 2rpx solid currentColor;
  font-size: 24rpx;
  font-weight: 700;
}

.ranking-placeholder__link-arrow {
  margin-left: 4rpx;
}
