page {
  --color-yellow: #ffc233;
  --color-yellow-soft: #fff4d6;
  --color-purple: #5423e7;
  --color-bg: #f4f1e8;
  --color-card: #fffdf8;
  --color-ink: #121217;
  --color-muted: #6c6c89;
  --color-white: #ffffff;

  background: var(--color-bg);
  color: var(--color-ink);
  font-family: "Times New Roman", "Noto Serif SC", "Songti SC", serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

button::after {
  border: none;
}

.app-page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.app-container {
  padding: 0 32rpx;
}

.app-card {
  border: 2rpx solid var(--color-ink);
  background: var(--color-card);
}

.app-tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--color-ink);
  background: var(--color-white);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.app-tag--yellow {
  background: var(--color-yellow);
}

.app-tag--purple {
  border-color: var(--color-purple);
  background: var(--color-purple);
  color: var(--color-white);
}

.app-tag--muted {
  border-color: transparent;
  background: rgba(18, 18, 23, 0.06);
  color: var(--color-muted);
}

.app-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-ink);
  background: var(--color-white);
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.app-btn--primary {
  background: var(--color-ink);
  color: var(--color-white);
}

.app-btn--yellow {
  background: var(--color-yellow);
  color: var(--color-ink);
}

.app-btn[disabled] {
  opacity: 0.4;
}

.app-section-kicker {
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.app-section-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.app-field {
  display: block;
}

.app-field__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.app-field__required {
  margin-left: 4rpx;
  color: var(--color-purple);
}

.app-field__input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-ink);
  background: var(--color-white);
  color: var(--color-ink);
  font-size: 28rpx;
}

.app-field__hint {
  display: block;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.app-error {
  margin: 16rpx 0;
  padding: 20rpx 24rpx;
  border: 2rpx solid #b00020;
  background: #fff0f0;
  color: #b00020;
  font-size: 24rpx;
}

.app-loading {
  padding: 120rpx 0;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: center;
}

.app-footer-text {
  padding: 24rpx 0;
  color: var(--color-muted);
  font-size: 22rpx;
  text-align: center;
}

.app-fixed-bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-ink);
  background: var(--color-card);
}
