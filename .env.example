# 复制为 .env（已被 .gitignore 忽略）用于本地开发；生产由容器/编排注入环境变量。
# 非敏感运行参数在 config.yaml（可用 CONFIG_FILE 指定其他路径）。
# 本文件只承载密钥、微信账户参数与运行环境标记。
#
# 生成随机密钥：openssl rand -hex 32

# ---- 运行环境 ----
# dev：支付材料缺失/不可读时自动回退 mock，允许 public_base_url 为空
# prod：支付材料必须完整且可读，public_base_url 必填；否则启动失败
APP_ENV=dev
# 非敏感配置文件路径（默认 config.yaml）
CONFIG_FILE=config.yaml

# ---- 始终必需 ----
JWT_SECRET=
ID_CARD_HMAC_KEY=
# 初始超管用户名在 config.yaml（admin.init_username）
ADMIN_INIT_PASSWORD=

# ---- 微信账户（全部经环境变量注入）----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCHID=
# 商户 API 证书序列号（apiclient_cert.pem 的序列号），请求签名用
WECHAT_MCH_SERIAL_NO=
# 微信支付公钥 ID（商户平台 → API 安全 → 微信支付公钥）
WECHAT_PAY_PUBLIC_KEY_ID=
# APIv3 密钥（32 字节），解密回调报文
WECHAT_PAY_API_V3_KEY=
# 商户 API 私钥（apiclient_key.pem）与微信支付公钥（wechatpay_pub_key.pem）
# 只接受文件路径；推荐只读挂载，PEM 内容不进入环境变量
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_PUBLIC_KEY_FILE=

# ---- 短信（可选，仅抽签提醒/结果通知使用；三项齐全才启用）----
# 本地联调可在 config.yaml 设置 sms.mock=true（只打脱敏日志，不调用阿里云）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 短信签名，须与阿里云已审核签名完全一致
SMS_SIGN_NAME=
# 抽签短信模板 CODE 按赛事在后台抽签页填写（每个赛事单独提审，见 API 文档 7.2.4）
