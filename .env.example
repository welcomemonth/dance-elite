# 复制为 .env（已被 .gitignore 忽略）用于本地开发；生产环境由容器/编排注入环境变量。
# 后端启动时会做自检：必需项缺失直接 fail-fast，并在错误日志中列出缺失项。
#
# 生成随机密钥：openssl rand -hex 32

# ---- 服务（非敏感，均有代码默认值）----
PORT=8080
DEBUG=true
# 日志级别 debug/info/warn/error；留空时 DEBUG=true 用 debug，否则 info
LOG_LEVEL=
# 日志格式 json/console；留空时 DEBUG=true 用 console，否则 json
LOG_FORMAT=
# 慢请求阈值（毫秒）：访问日志延迟超过该值时升为 WARN 并带 slow=true；0 关闭
SLOW_REQUEST_MS=500
DB_PATH=data/dance-elite.db
# 上传文件物理目录（证件照/音频/头像）；生产须挂 volume，赛后媒体清理保留 avatars/
UPLOAD_DIR=uploads
PAY_MOCK=true
JWT_EXPIRE_SECONDS=7200
# 定时任务：赛事状态自动流转轮询间隔（秒）
STATUS_TICK_SECONDS=60
# 待支付订单超时（分钟）：超时先查单，确认未支付才系统取消并释放名额
ORDER_EXPIRE_MINUTES=15
# 退款卡死判定窗口（分钟）：processing/approved 超过该时长无回调时主动查微信退款单
REFUND_WATCHDOG_MINUTES=10
# 对外访问地址（拼接音频审核 H5 链接等外链）；为空时返回相对路径 /audio-review/{token}
PUBLIC_BASE_URL=

# ---- 始终必需 ----
JWT_SECRET=
ID_CARD_HMAC_KEY=
WECHAT_APPID=
WECHAT_SECRET=
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# ---- 真实支付（PAY_MOCK=false）时必需 ----
WECHAT_MCHID=
# APIv3 密钥：32 字节，回调报文 AES-256-GCM 解密用
WECHAT_PAY_KEY=
# 商户 API 证书序列号（请求签名；对应 apiclient_cert.pem 的序列号）
WECHAT_MCH_SERIAL_NO=
# 微信支付平台证书 PEM（回调验签公钥；证书轮换时更新）
# 注意：是商户平台「API 安全 → 平台证书」下载的文件，不是商户 API 证书 apiclient_cert.pem；
# 二者序列号不同，配错会导致支付回调验签全部失败（订单迟迟不变为已支付）。
# 二选一：直接填 PEM 文本，或填文件路径（推荐，容器只读挂载，如 /run/secrets/platform_cert.pem）
WECHAT_PAY_CERT=
WECHAT_PAY_CERT_FILE=
# 商户 API 私钥 PEM（PKCS#8/PKCS#1，可用 \n 单行写法）
# 二选一：直接填 PEM 文本，或填文件路径（推荐，容器只读挂载，如 /run/secrets/apiclient_key.pem）
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_FILE=
# 支付结果回调地址，指向 POST /api/v1/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=
# 退款结果回调地址，指向 POST /api/v1/payments/wechat/refund-notify
WECHAT_REFUND_NOTIFY_URL=
